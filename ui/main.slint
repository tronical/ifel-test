import { Button, VerticalBox, HorizontalBox, GroupBox } from "std-widgets.slint";

// INTERFACE IMPORT
import { CallInterface, DeviceInterface } from "./Interfaces.slint"; 
export { CallInterface, DeviceInterface }  

export component MainWindow inherits Window {
    title: "invoke_from_event_loop nested test";
    preferred-width: 520px;
    preferred-height: 280px;

    in-out property <string> status_text: "Idle. Press a button to start a thread.";
    in-out property <bool> yesButtonPressed : false;
    in-out property <bool> noButtonPressed : false;

    callback start_one(string); // Simulate Press       // string->ButtonID
    callback start_two(string); // Simulate Release     // string->ButtonID

    // Invoked from the outer invoke_from_event_loop lambda. Implemented
    // in C++ — the handler there schedules another invoke_from_event_loop
    // whose lambda updates `status_text`.
    callback nested_step(string, int);

    // HANDLERS (Implemented in Slint. Invoked from C++.)
    callback handlerButtonReleased(string);  // Triggered on physical button release (press + release). String contains name of button (matching Device.Button).

    callback signalSendMessage(string, string);                // NEW 2026.

    handlerButtonReleased(ButtonID) => {
        debug("UI - handlerButtonReleased ", ButtonID);

        if (ButtonID == "yes") {
            signalSendMessage("1", "Yes Button clicked");
        } else if (ButtonID == "no") {
            signalSendMessage("1", "No Button clicked");
        }
    }

    signalSendMessage(CallID, Message) => {  // NEW 2026. Dummy impl in ui
        debug("UI impl - signalSendMessage :  ",CallID, Message);  // CallID: Call ID receiving message. Message: Message to send.
    }


    VerticalBox {
        spacing: 12px;
        padding: 16px;

        HorizontalBox {
            spacing: 8px;

            yesButton := Rectangle {
                property <string> buttonID : "yes";
                background: (yesButtonPressed || taYes.pressed) ? #228029 : #00ff00;
                width: 100px;
                height: 50px;
                
                Text {
                    text: "Yes";
                }
    
                taYes := TouchArea {
                    clicked => {
                        signalSendMessage("1", "Yes Button clicked");
                    }
                }
            }

            HorizontalBox {
            
                spacing: 8px;
                Button {
                    // height: 50px;
                    text: "Simulate Press";
                    clicked => { 
                        debug("UI - Simulating Press - Yes");
                        root.start_one(yesButton.buttonID);
                     }
                }
                Button {
                    // height: 50px;
                    text: "Simulate Release";
                    clicked => { 
                        debug("UI - Simulating Release - Yes");
                        root.start_two(yesButton.buttonID); 
                    }
                }
    
            }
        }


        HorizontalBox {
            spacing: 8px;

            noButton := Rectangle {
                property <string> buttonID : "no";
                background: (noButtonPressed || taNo.pressed) ? #802222 : #da4a4a;
                width: 100px;
                height: 50px;
                
                Text {
                    text: "No";
                }
    
                taNo := TouchArea {
                    clicked => {
                        signalSendMessage("1", "No Button clicked");
                    }
                }
            }

            HorizontalBox {
            
                spacing: 8px;
                Button {
                    // height: 50px;
                    text: "Simulate Press";
                    clicked => { 
                        debug("UI - Simulating Press - No");
                        root.start_one(noButton.buttonID);
                     }
                }
                Button {
                    // height: 50px;
                    text: "Simulate Release";
                    clicked => { 
                        debug("UI - Simulating Release - No");
                        root.start_two(noButton.buttonID); 
                    }
                }
    
            }
        }





    }
}
