import { Button, VerticalBox, HorizontalBox, GroupBox } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "invoke_from_event_loop nested test";
    preferred-width: 520px;
    preferred-height: 280px;

    in-out property <string> status_text: "Idle. Press a button to start a thread.";

    callback start_one();
    callback start_two();
    callback start_three();

    // Invoked from the outer invoke_from_event_loop lambda. Implemented
    // in C++ — the handler there schedules another invoke_from_event_loop
    // whose lambda updates `status_text`.
    callback nested_step(string, int);

    VerticalBox {
        spacing: 12px;
        padding: 16px;

        Text {
            text: "Slint 1.10 — nested slint::invoke_from_event_loop test";
            font-size: 16px;
            font-weight: 700;
        }

        GroupBox {
            title: "Status";
            Text {
                text: status_text;
                wrap: word-wrap;
                font-size: 14px;
            }
        }

        HorizontalBox {
            spacing: 8px;
            Button {
                text: "Start thread A";
                clicked => { root.start_one(); }
            }
            Button {
                text: "Start thread B";
                clicked => { root.start_two(); }
            }
            Button {
                text: "Start thread C";
                clicked => { root.start_three(); }
            }
        }
    }
}
