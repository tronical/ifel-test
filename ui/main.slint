import { Button, VerticalBox, HorizontalBox, GroupBox } from "std-widgets.slint";

// INTERFACE IMPORT
// import { CallInterface, DeviceInterface } from "./Interfaces.slint"; 


export component MainWindow inherits Window {
    title: "invoke_from_event_loop nested test";
    preferred-width: 520px;
    preferred-height: 280px;

    in-out property <string> status_text: "Idle. Press a button to start a thread.";
    in-out property <bool> buttonPressed : false;

    callback start_one();
    callback start_two();

    // Invoked from the outer invoke_from_event_loop lambda. Implemented
    // in C++ — the handler there schedules another invoke_from_event_loop
    // whose lambda updates `status_text`.
    callback nested_step(string, int);

    // HANDLERS (Implemented in Slint. Invoked from C++.)
    callback handlerButtonReleased(string);  // Triggered on physical button release (press + release). String contains name of button (matching Device.Button).

    callback signalSendMessage(string, string);                // NEW 2026.

    handlerButtonReleased(ButtonID) => {
        debug("UI - handlerButtonReleased ", ButtonID);

        signalSendMessage("1", "Button clicked");
    }

    signalSendMessage(CallID, Message) => {  // NEW 2026. Dummy impl in ui
        debug("UI impl - signalSendMessage :  ",CallID, Message);  // CallID: Call ID receiving message. Message: Message to send.
    }


    VerticalBox {
        spacing: 12px;
        padding: 16px;

        Rectangle {
            background: (buttonPressed || ta.pressed) ? #228029 : #00ff00;
            width: 100px;
            height: 50px;
            
            Text {
                text: "Click me";
            }

            ta := TouchArea {
                clicked => {
                    signalSendMessage("1", "Button clicked");
                }
            }
            
        }


        HorizontalBox {
            
            spacing: 8px;
            Button {
                height: 50px;
                text: "Simulate Press";
                clicked => { 
                    debug("UI - Simulating Press");
                    root.start_one();
                 }
            }
            Button {
                height: 50px;
                text: "Simulate Release";
                clicked => { 
                    debug("UI - Simulating Release");
                    root.start_two(); 
                }
            }

        }
    }
}
